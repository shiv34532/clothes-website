# ==============================================================================
# LITTLE TO LARGE - COMPLETE ENVIRONMENT CONFIGURATION TEMPLATE
# ==============================================================================
# Copy this file to .env and fill in your actual credentials:
#   copy .env.example .env (Windows CMD) or cp .env.example .env (Bash)
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. CORE SERVER & AUTHENTICATION
# ------------------------------------------------------------------------------
PORT=3000
# Generate a strong 32+ character random secret string
JWT_SECRET=little_to_large_super_secret_jwt_key_2026_secure
# Optional: Comma-separated IP whitelist for accessing /admin.html (leave blank to allow all IPs)
ADMIN_IP_WHITELIST=

# ------------------------------------------------------------------------------
# 2. EMAIL NOTIFICATIONS (Google Gmail SMTP - Free up to 500 emails/day)
# ------------------------------------------------------------------------------
# Steps to generate GMAIL_APP_PASSWORD:
#   1. Go to your Google Account -> Security (https://myaccount.google.com/security)
#   2. Ensure "2-Step Verification" is turned ON.
#   3. Search or navigate to "App passwords" (https://myaccount.google.com/apppasswords)
#   4. Enter "Little to Large Website" as the app name and click Create.
#   5. Copy the 16-character password (without spaces) below.
GMAIL_USER=indiancloths980@gmail.com
GMAIL_APP_PASSWORD=your_16_character_app_password_here
ADMIN_NOTIFICATION_EMAIL=indiancloths980@gmail.com

# ------------------------------------------------------------------------------
# 3. RAZORPAY PAYMENT GATEWAY
# ------------------------------------------------------------------------------
# Get your keys from: https://dashboard.razorpay.com/app/keys
# Use rzp_test_... for Sandbox testing, and rzp_live_... for Production.
RAZORPAY_KEY_ID=rzp_test_yourKeyHere
RAZORPAY_KEY_SECRET=yourSecretHere

# ------------------------------------------------------------------------------
# 4. CLOUDINARY MEDIA & CLOUD STORAGE
# ------------------------------------------------------------------------------
# Used for storing product images, banners, and AI studio media in the cloud.
# Get keys from Cloudinary Dashboard: https://console.cloudinary.com/
CLOUDINARY_CLOUD_NAME=wzknhexk
CLOUDINARY_API_KEY=775349879285534
CLOUDINARY_API_SECRET=UioxSzxXyfcVORlZRZy_36JOS68

# ------------------------------------------------------------------------------
# 5. GOOGLE GEMINI AI (Virtual Studio, Visual Search, AI Product Copy)
# ------------------------------------------------------------------------------
# Get a 100% Free Gemini API key from Google AI Studio:
# https://aistudio.google.com/app/apikey
GEMINI_API_KEY=your_gemini_api_key_here

# ------------------------------------------------------------------------------
# 6. SHIPROCKET AUTOMATED SHIPPING & COURIER TRACKING
# ------------------------------------------------------------------------------
# Create an account at https://app.shiprocket.in/
# Enter your login email and password (can also be saved in the Admin Settings tab)
SHIPROCKET_EMAIL=
SHIPROCKET_PASSWORD=

# ------------------------------------------------------------------------------
# 7. SMS & WHATSAPP OTP NOTIFICATIONS (Optional)
# ------------------------------------------------------------------------------
# Fast2SMS (Indian SMS Gateway - https://www.fast2sms.com/):
FAST2SMS_API_KEY=

# Or Twilio SMS (Global - https://www.twilio.com/console):
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_FROM_PHONE=

# ------------------------------------------------------------------------------
# 8. DATABASE CONFIGURATION (Leave blank for default SQLite3 mode)
# ------------------------------------------------------------------------------
# Mode A: SQLite3 (DEFAULT - Zero configuration, runs automatically in little_to_large.db)

# Mode B: PostgreSQL (Supabase / Render / Neon / Railway / Local Postgres)
# DATABASE_URL=postgresql://user:password@host:5432/little_to_large?sslmode=require
# Or individual PG parameters:
# PGHOST=localhost
# PGUSER=postgres
# PGPASSWORD=your_postgres_password
# PGDATABASE=little_to_large
# PGPORT=5432
# PGSSL=true

# Mode C: MySQL (Production VPS / cPanel / AWS RDS)
# DB_HOST=localhost
# DB_USER=root
# DB_PASSWORD=your_mysql_password
# DB_NAME=little_to_large
# DB_PORT=3306
